---
// PrivacyEmbed.astro — 2-click consent overlay for third-party embeds.
// Ported from mandrasch.dev; adapted for Karenz Wizard.
//
//   - No iframe (and therefore no request to the provider) is created until
//     the user explicitly clicks. Consent is remembered per provider for the
//     current browser session.
//   - `poster` is optional. Without it the component shows the text consent
//     box used on the step pages. With it, a self-hosted thumbnail + play
//     button is shown instead (never hotlink thumbnails: that would leak an
//     IP to the provider before consent).
//   - Karenz Wizard runs without Astro's View Transitions router, so init
//     runs on DOMContentLoaded (or immediately if the DOM is already parsed)
//     in addition to `astro:page-load`. A `data-initialized` guard keeps
//     multiple init calls safe.

interface Props {
  provider: 'youtube' | 'twitter' | 'mastodon' | 'vimeo' | 'other';
  embedUrl: string;
  title?: string;
  directUrl?: string;
  /** Optional self-hosted URL of a poster image (e.g. /blog-images/foo.jpg). */
  poster?: string;
  posterAlt?: string;
}

const {
  provider,
  embedUrl,
  title = 'Eingebetteter Inhalt',
  directUrl,
  poster,
  posterAlt = '',
} = Astro.props;

const providerNames: Record<string, string> = {
  youtube: 'YouTube',
  twitter: 'Twitter/X',
  mastodon: 'Mastodon',
  vimeo: 'Vimeo',
  other: 'diesem Dienst',
};

const providerName = providerNames[provider] || providerNames.other;
const storageKey = `embed-consent-${provider}`;
const hasPoster = Boolean(poster);
const isShorts = provider === 'youtube' && embedUrl.includes('/shorts/');
---

<div
  class:list={[
    'privacy-embed',
    'not-prose',
    {
      'privacy-embed--poster': hasPoster,
      'privacy-embed--shorts': isShorts,
    },
  ]}
  data-provider={provider}
  data-embed-url={embedUrl}
  data-storage-key={storageKey}
  data-title={title}
>
  <div class="privacy-overlay">
    {
      hasPoster ? (
        <div class="privacy-poster">
          <img src={poster} alt={posterAlt} decoding="async" />
          <button
            type="button"
            class="privacy-play"
            data-action="load-once"
            aria-label={`Video von ${providerName} laden: ${title}`}
          >
            <svg
              class="privacy-play-icon"
              viewBox="0 0 64 64"
              fill="currentColor"
              aria-hidden="true"
            >
              <circle cx="32" cy="32" r="32" fill="rgba(15, 23, 42, 0.72)" />
              <path d="M25 19.5v25l21-12.5-21-12.5z" fill="#fff" />
            </svg>
          </button>
        </div>
      ) : (
        <div class="privacy-content">
          <div class="privacy-icon">
            {provider === 'youtube' ? (
              <svg class="h-16 w-16 text-red-600" fill="currentColor" viewBox="0 0 24 24">
                <path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z" />
              </svg>
            ) : (
              <svg
                class="h-16 w-16 text-primary"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M15 10l4.553-2.276A1 1 0 0121 8.618v6.764a1 1 0 01-1.447.894L15 14M5 18h8a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v8a2 2 0 002 2z"
                />
              </svg>
            )}
          </div>

          <h3 class="privacy-title">{title}</h3>

          <p class="privacy-description">
            Dieser Inhalt wird von {providerName} bereitgestellt. Beim Laden werden Daten an{' '}
            {providerName} übertragen.
          </p>

          <div class="privacy-actions">
            <button type="button" class="privacy-load-btn" data-action="load-once">
              Inhalte von {providerName} laden
            </button>
          </div>

          {directUrl && (
            <a
              href={directUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="privacy-direct-link"
            >
              Direkt auf {providerName} öffnen →
            </a>
          )}
        </div>
      )
    }

    {
      hasPoster && (
        <p class="privacy-note">
          Beim Abspielen werden Daten an {providerName} übertragen.{' '}
          {directUrl && (
            <a
              href={directUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="privacy-direct-link"
            >
              Direkt auf {providerName} öffnen →
            </a>
          )}
        </p>
      )
    }
  </div>

  <div class="privacy-embed-container" hidden></div>
</div>

<script>
  class PrivacyEmbed {
    element: HTMLElement;
    provider: string;
    embedUrl: string;
    storageKey: string;
    title: string;
    overlay: HTMLElement;
    container: HTMLElement;
    trigger: HTMLButtonElement | null;
    loaded = false;

    constructor(element: HTMLElement) {
      this.element = element;
      this.provider = element.dataset.provider!;
      this.embedUrl = element.dataset.embedUrl!;
      this.storageKey = element.dataset.storageKey!;
      this.title = element.dataset.title || 'Eingebetteter Inhalt';

      this.overlay = element.querySelector('.privacy-overlay') as HTMLElement;
      this.container = element.querySelector('.privacy-embed-container') as HTMLElement;
      this.trigger = element.querySelector('[data-action="load-once"]');
      this.init();
    }

    init() {
      // Consent is session-scoped, so it is gone after closing the tab.
      try {
        if (sessionStorage.getItem(this.storageKey) === 'granted') {
          this.loadEmbed();
          return;
        }
      } catch {
        // sessionStorage can be unavailable (private mode / blocked cookies).
      }

      this.trigger?.addEventListener('click', () => this.handleLoad());

      // Accepting one embed reveals all embeds of the same provider on the page.
      document.addEventListener('privacy-embed-consent', (event) => {
        const detail = (event as CustomEvent<{ provider: string }>).detail;
        if (detail?.provider === this.provider && !this.loaded) {
          this.loadEmbed();
        }
      });
    }

    handleLoad() {
      try {
        sessionStorage.setItem(this.storageKey, 'granted');
      } catch {
        // Ignore storage failures; the embed still loads for this view.
      }
      document.dispatchEvent(
        new CustomEvent('privacy-embed-consent', { detail: { provider: this.provider } })
      );
      this.loadEmbed();
    }

    loadEmbed() {
      if (this.loaded) return;
      this.loaded = true;

      this.overlay.hidden = true;
      this.container.hidden = false;

      const iframe = document.createElement('iframe');
      iframe.src = this.embedUrl;
      iframe.title = this.title;
      iframe.loading = 'lazy';
      iframe.referrerPolicy = 'strict-origin-when-cross-origin';
      iframe.allow =
        'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share';
      iframe.allowFullscreen = true;

      this.container.appendChild(iframe);
    }
  }

  // Initialize all privacy embeds that haven't been set up yet.
  // Uses a data attribute to guard against double-init.
  function initPrivacyEmbeds() {
    const embeds = document.querySelectorAll<HTMLElement>('.privacy-embed:not([data-initialized])');
    embeds.forEach((embed) => {
      embed.dataset.initialized = 'true';
      new PrivacyEmbed(embed);
    });
  }

  // Karenz Wizard runs without Astro's View Transitions router, so the
  // original `astro:page-load` listener never fires. Run on DOMContentLoaded
  // (or immediately if the DOM is already parsed) instead. Still listen to
  // `astro:page-load` too — harmless with the data-initialized guard if
  // View Transitions are ever enabled later.
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initPrivacyEmbeds);
  } else {
    initPrivacyEmbeds();
  }
  document.addEventListener('astro:page-load', initPrivacyEmbeds);
</script>

<style>
  .privacy-embed {
    margin: 2rem 0;
  }

  .privacy-overlay {
    background: #f8fafc;
    border: 1px solid rgb(226 232 240);
    border-radius: 12px;
    padding: clamp(1.5rem, 4vw, 2.5rem) 1.5rem;
    text-align: center;
  }

  .privacy-overlay[hidden],
  .privacy-embed-container[hidden] {
    display: none;
  }

  .privacy-content {
    max-width: 34rem;
    margin: 0 auto;
  }

  .privacy-icon {
    margin-bottom: 1.25rem;
    display: flex;
    justify-content: center;
  }

  .privacy-title {
    margin: 0 0 0.75rem;
    font-size: 1.375rem;
    font-weight: 700;
    line-height: 1.3;
    color: var(--aw-color-text-heading);
  }

  .privacy-description {
    margin: 0 0 1.5rem;
    line-height: 1.6;
    color: var(--aw-color-text-muted);
  }

  .privacy-actions {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    margin-bottom: 1.25rem;
  }

  .privacy-load-btn {
    padding: 0.75rem 2rem;
    border: none;
    border-radius: 9999px;
    background: #c94d54;
    color: #fff;
    font-weight: 600;
    cursor: pointer;
    transition:
      background-color 0.2s ease,
      transform 0.2s ease;
  }

  .privacy-load-btn:hover {
    background: #b64048;
    transform: translateY(-1px);
  }

  .privacy-load-btn:focus-visible,
  .privacy-play:focus-visible {
    outline: 2px solid #c94d54;
    outline-offset: 3px;
  }

  .privacy-direct-link {
    display: inline-block;
    color: #c94d54;
    font-size: 0.875rem;
    text-decoration: none;
  }

  .privacy-direct-link:hover {
    text-decoration: underline;
  }

  .privacy-embed-container {
    overflow: hidden;
    aspect-ratio: 16 / 9;
    border-radius: 12px;
    background: #000;
  }

  /* :global() is required because the iframe is created by the client script
     and therefore has no Astro scope attribute. */
  .privacy-embed-container :global(iframe) {
    display: block;
    width: 100%;
    height: 100%;
    border: 0;
  }

  .privacy-embed--shorts .privacy-embed-container {
    max-width: 22.5rem;
    margin-inline: auto;
    aspect-ratio: 9 / 16;
  }

  /* Optional poster variant (2-click UI with a self-hosted thumbnail). */
  .privacy-embed--poster .privacy-overlay {
    padding: 0;
    border: 0;
    background: transparent;
  }

  .privacy-poster {
    position: relative;
    overflow: hidden;
    aspect-ratio: 16 / 9;
    border-radius: 12px;
    background: #0f172a;
  }

  .privacy-embed--shorts .privacy-poster {
    max-width: 22.5rem;
    margin-inline: auto;
    aspect-ratio: 9 / 16;
  }

  .privacy-poster img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0.85;
  }

  .privacy-play {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 100%;
    padding: 0;
    border: none;
    background: transparent;
    color: #fff;
    cursor: pointer;
  }

  .privacy-play-icon {
    width: clamp(3.5rem, 12vw, 5rem);
    height: clamp(3.5rem, 12vw, 5rem);
    filter: drop-shadow(0 4px 12px rgb(0 0 0 / 35%));
    transition: transform 0.2s ease;
  }

  .privacy-play:hover .privacy-play-icon {
    transform: scale(1.06);
  }

  .privacy-note {
    margin: 0.75rem 0 0;
    font-size: 0.875rem;
    color: var(--aw-color-text-muted);
    text-align: center;
  }
</style>
